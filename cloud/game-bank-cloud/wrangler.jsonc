{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-bank-cloud-preview",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "main": "src/index.js",
  "observability": { "enabled": true }
}
